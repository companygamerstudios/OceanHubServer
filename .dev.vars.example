# SOLO PARA DESARROLLO LOCAL. NO PEGUES AQUÍ SECRETOS DE PRODUCCIÓN.
# Copia este archivo como .dev.vars y reemplaza los valores por secretos de prueba.
# Genera valores aleatorios nuevos; no reutilices estos marcadores.

DYNAMIC_KEY_ENCRYPTION_SECRET=REPLACE_WITH_RANDOM_LOCAL_SECRET_64_HEX
DYNAMIC_KEY_INDEX_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_LOCAL_SECRET_64_HEX
ADMIN_SECOND_PIN=LOCAL_ONLY_CHANGE_ME
TOTP_SECRET=LOCAL_ONLY_USE_A_TEST_AUTHENTICATOR_SECRET
HMAC_SECRET_CURRENT=REPLACE_WITH_RANDOM_LOCAL_SECRET_64_HEX
HMAC_SECRET_PREVIOUS=REPLACE_WITH_DIFFERENT_RANDOM_LOCAL_SECRET_64_HEX

# Deja los proveedores vacíos para que las llamadas a IA fallen de forma segura.
# Usa credenciales de sandbox para pruebas de OAuth o pagos; nunca credenciales live.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
STABLE_HORDE_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
BREVO_API_KEY=
DISCORD_WEBHOOK_URL=
STATIC_KEYS_JSON=[]
