{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oceanhub-staging-REPLACE_ME",
  "main": "OceanHub_SECURITY_PATCHED_FINAL_v18.js",
  "compatibility_date": "2026-09-27",
  "vars": {
    "BASE_URL": "https://REPLACE_WITH_STAGING_HOSTNAME.workers.dev",
    "PAYPAL_MODE": "sandbox",
    "ADMIN_REQUIRE_2FA": "true",
    "SENDER_NAME": "Ocean Hub Staging",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "OPENROUTER_MODEL": "openrouter/free",
    "GEMINI_IMAGE_MODEL": "gemini-2.0-flash-preview-image-generation",
    "AF_EXTRA_MODELS": "[]"
  },
  "kv_namespaces": [
    {
      "binding": "STATS",
      "id": "REPLACE_WITH_32_HEX_STAGING_KV_NAMESPACE_ID"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KV_LOCKER",
        "class_name": "KVLocker"
      }
    ]
  },
  "exports": {
    "KVLocker": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "keep_vars": true,
  "secrets": {
    "required": [
      "DYNAMIC_KEY_ENCRYPTION_SECRET",
      "DYNAMIC_KEY_INDEX_SECRET",
      "ADMIN_SECOND_PIN",
      "TOTP_SECRET",
      "HMAC_SECRET_CURRENT",
      "PAYPAL_SECRET",
      "PAYPAL_WEBHOOK_ID",
      "BREVO_API_KEY",
      "GEMINI_API_KEY",
      "OPENROUTER_API_KEY",
      "GOOGLE_CLIENT_SECRET",
      "DISCORD_CLIENT_SECRET"
    ]
  }
}
