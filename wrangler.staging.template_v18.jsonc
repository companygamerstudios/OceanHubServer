{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oceanhub-staging-REPLACE_ME",
  "main": "OceanHub_SECURITY_PATCHED_FINAL_v18.js",
  "compatibility_date": "2026-09-27",
  "vars": {
    "BASE_URL": "https://REPLACE_WITH_STAGING_HOSTNAME.workers.dev",
    "PAYPAL_MODE": "sandbox",
    "ADMIN_REQUIRE_2FA": "true",
    "SENDER_NAME": "Ocean Hub Staging",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "OPENROUTER_MODEL": "openrouter/free",
    "AF_EXTRA_MODELS": "[]",
    "AF_IMAGE_PROVIDER": "disabled"
  },
  "kv_namespaces": [
    {
      "binding": "STATS",
      "id": "00000000000000000000000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KV_LOCKER",
        "class_name": "KVLocker"
      }
    ]
  },
  "exports": {
    "KVLocker": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "keep_vars": false
}
