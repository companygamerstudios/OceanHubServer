{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OceanHub",
  "version": "3.0.1",
  "identifier": "com.companygamerstudios.oceanhub",
  "build": {
    "devUrl": "https://oceanhud.yoelenmanuelzorrilla.workers.dev/?clientVersion=3.0.1",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OceanHub",
        "width": 1440,
        "height": 920,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "https://oceanhud.yoelenmanuelzorrilla.workers.dev/?clientVersion=3.0.1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; img-src 'self' data: asset: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://oceanhud.yoelenmanuelzorrilla.workers.dev wss://oceanhud.yoelenmanuelzorrilla.workers.dev"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "SocialNetworking",
    "shortDescription": "La aplicación independiente de OceanHub",
    "longDescription": "OceanHub es el espacio gamer y social de COMPANY GAMER STUDIOS.",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 3000002
    }
  }
}
