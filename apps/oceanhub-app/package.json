{
  "name": "oceanhub-app",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "node --check src-tauri/loading-splash.js && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1421 --strictPort",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:init": "tauri android init",
    "tauri:android:build": "tauri android build --apk",
    "icons:android": "tauri icon ./assets/oceanhub-android.svg --output ./src-tauri/icons",
    "icons:windows": "tauri icon ./assets/oceanhub-windows.svg --output ./src-tauri/icons"
  },
  "dependencies": {"@tauri-apps/api": "2.12.5"},
  "devDependencies": {"@tauri-apps/cli": "2.12.5", "typescript": "7.0.2", "vite": "8.3.8"}
}
