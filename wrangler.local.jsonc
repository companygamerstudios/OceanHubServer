{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oceanhub-local",
  "main": "OceanHub_SECURITY_PATCHED_FINAL_v18.js",
  "compatibility_date": "2026-09-27",
  "vars": {
    "BASE_URL": "http://127.0.0.1:8787",
    "PAYPAL_MODE": "sandbox",
    "ADMIN_REQUIRE_2FA": "true",
    "SENDER_NAME": "Ocean Hub Local",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "OPENROUTER_MODEL": "openrouter/free",
    "AF_EXTRA_MODELS": "[]"
  },
  "kv_namespaces": [
    {
      "binding": "STATS",
      "id": "00000000000000000000000000000001"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KV_LOCKER",
        "class_name": "KVLocker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "KVLocker"
      ]
    }
  ]
}
